APP_NAME=Ab Kurye
# Pazarlama sayfası markası (boşsa APP_NAME kullanılır)
# MARKETING_BRAND_NAME=Ab Kurye
# MARKETING_LOGO_MARK=Ab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Tarayıcı adresiyle aynı host kullanın (localhost ile 127.0.0.1 oturum çerezi farklıdır)
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=platform_db
DB_USERNAME=root
DB_PASSWORD=

# Yerelde file genelde sorunsuz; database için sessions tablosu gerekir
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTP geliştirmede false kalsın; üretim HTTPS'te true yapın
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Redis kuyruk: job süresinden büyük olmalı (webhook + Horizon).
# REDIS_QUEUE_RETRY_AFTER=180
# İş yüküne göre kuyruk adları (Horizon config/horizon.php ile uyumlu).
# QUEUE_DISPATCH=dispatch
# QUEUE_INTEGRATIONS=integrations
# QUEUE_NOTIFICATIONS=notifications

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Laravel Horizon: Redis kuyruk paneli (Linux üretim; Windows’ta horizon çalışmaz — queue:work kullanın).
# Kurulum: composer require laravel/horizon (gerekirse --ignore-platform-req=ext-pcntl --ignore-platform-req=ext-posix)
# Çalıştırma: php artisan horizon | Üretimde Supervisor. Dashboard /horizon — staging/production’da yalnızca super_admin.
# HORIZON_PREFIX=
# HORIZON_PATH=horizon
# Zamanlanmış: crontab * * * * * cd /path && php artisan schedule:run (horizon:snapshot dahil)
# Supervisor örneği: deploy/supervisor-horizon.conf.example

# Kurye konumlarını Redis GEO ile indeksle (yakın kurye / harita). false = yalnızca DB (courier_locations).
# Binlerce eşzamanlı kuryede üretimde true + ayrı Redis örneği önerilir (GEOADD yükü).
COURIER_GEO_REDIS=false
# Redis GEOADD işini kuyruğa at (COURIER_GEO_REDIS=true ve queue worker gerekir).
# COURIER_GEO_REDIS_ASYNC=false
# COURIER_GEO_REDIS_QUEUE=geo
# POST /api/v1/courier/location — kurye başına dakika limiti (varsayılan 180).
# COURIER_LOCATION_POSTS_PER_MINUTE=180
# Otomatik atama: Redis ile yakındaki kurye id ön filtresi (km / adet).
# DISPATCH_GEO_PREFILTER_RADIUS_KM=35
# DISPATCH_GEO_PREFILTER_LIMIT=120
# Redis anahtarı öneki; firma başına: {COURIER_GEO_REDIS_KEY}:{firm_id}
# COURIER_GEO_REDIS_KEY=kurye:couriers:geo
# COURIER_GEO_REDIS_CONNECTION=default
# GEO key TTL (saniye). Firma GEO set'i için key TTL (per-kurye TTL değildir).
# COURIER_GEO_REDIS_KEY_TTL_SECONDS=172800
# COURIER_OPERATIONS_SNAPSHOT_ORDERS=80
# COURIER_OPERATIONS_NEAR_KM=5
# COURIER_OPERATIONS_NEAR_LIMIT=8
# Otomatik atama ağırlıkları (config/courier.php varsayılanları)
# DISPATCH_WEIGHT_DISTANCE=1
# DISPATCH_WEIGHT_ACTIVE_ORDERS=2
# DISPATCH_WEIGHT_STALE=0.15
# DISPATCH_LOCATION_MAX_AGE_MINUTES=15

# Harita (tile provider)
# Varsayılan: public OSM tile. Üretimde maliyet/kota riskini azaltmak için kendi cache proxy'nize yönlendirin.
# MAP_TILES_URL=https://tiles.yourdomain.com/{z}/{x}/{y}.png
# MAP_TILES_ATTRIBUTION=&copy; OpenStreetMap contributors

# OSRM (routing/ETA) — self-host
# OSRM_BASE_URL=http://127.0.0.1:5000
# OSRM_PROFILE=driving
# OSRM_TIMEOUT_SECONDS=6

TENANCY_DB_PREFIX=tenant_company_
ASSIGNMENT_ACCEPT_TIMEOUT_SECONDS=30
ASSIGNMENT_SEARCH_RADIUS_METERS=5000
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Giriş sayfasında test hesaplarını göster (production'da kapalı kalsın)
SHOW_DEV_LOGIN_HINT=true
# Demo şifre ipucu metni (config/dev_login.php içindeki hesaplarla aynı olmalı)
DEV_TEST_PASSWORD=password

# Mağaza: firma ayarı yoksa kullanılan varsayılan teslimat ücreti (₺)
SHOP_DEFAULT_DELIVERY_FEE=15
SHOP_DELIVERY_DISTANCE_BASE_FEE=15
SHOP_DELIVERY_DISTANCE_PER_KM=4
SHOP_DELIVERY_DISTANCE_MIN_FEE=10
SHOP_DELIVERY_DISTANCE_MAX_FEE=120

# Ödeme: local (demo anında onay) | null (eski null sağlayıcı)
PAYMENT_DRIVER=local

# Pazar yeri: gelen webhook IP başına dakika limiti (config: marketplace_integrations.webhook_per_minute)
#INTEGRATION_WEBHOOK_PER_MINUTE=120
#INTEGRATION_WEBHOOK_MAX_BODY_BYTES=524288
# Giden durum bildirimi HTTP (config: marketplace_integrations.status_push)
#MARKETPLACE_STATUS_PUSH_TIMEOUT=12
#MARKETPLACE_STATUS_PUSH_HTTP_RETRIES=3
#MARKETPLACE_STATUS_PUSH_HTTP_RETRY_MS=400
#MARKETPLACE_STATUS_QUEUE_RETRY=true
#MARKETPLACE_STATUS_QUEUE_TRIES=4
#MARKETPLACE_STATUS_UNIQUE_LOCK=900

# true: finans ve raporlarda yalnızca payment_method=online teslim siparişleri (kapıda nakit/kart hariç)
#KURYE_FINANCE_ONLINE_ORDERS_ONLY=false

# Adres metninden koordinat (OSM Nominatim). user_agent zorunlu kullanım politikası.
#NOMINATIM_ENABLED=true
#NOMINATIM_URL=https://nominatim.openstreetmap.org
#NOMINATIM_USER_AGENT="KuryePlatform/1.0 (+https://ornek-domain/responsible)"
#NOMINATIM_COUNTRY_CODES=tr
#NOMINATIM_TIMEOUT=8
